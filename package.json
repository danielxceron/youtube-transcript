{
  "name": "@danielxceron/youtube-transcript",
  "version": "2.0.0",
  "description": "Fetch transcript from a youtube video",
  "main": "dist/youtube-transcript.common.js",
  "browser": "dist/youtube-transcript.mjs",
  "module": "dist/youtube-transcript.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/youtube-transcript.mjs",
      "require": "./dist/youtube-transcript.common.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "smoke": "node example/cli.mjs"
  },
  "author": "Daniel Cerón Claros <danielxceron@gmail.com> (https://github.com/danielxceron)",
  "contributors": [
    "Kakulukian (Original author)"
  ],
  "keywords": [
    "youtube",
    "transcript",
    "captions",
    "subtitles",
    "youtube-transcript",
    "innertube",
    "timedtext",
    "asr"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "rollup": "^4.65.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielxceron/youtube-transcript.git"
  },
  "bugs": {
    "url": "https://github.com/danielxceron/youtube-transcript/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/danielxceron/youtube-transcript",
  "engines": {
    "node": ">=20"
  }
}
