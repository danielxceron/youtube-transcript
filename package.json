{
  "name": "@danielxceron/youtube-transcript",
  "version": "1.3.0",
  "description": "Fetch transcript from a youtube video",
  "main": "dist/youtube-transcript.common.js",
  "browser": "dist/youtube-transcript.mjs",
  "module": "dist/youtube-transcript.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/youtube-transcript.mjs",
      "require": "./dist/youtube-transcript.common.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node example/cli.mjs"
  },
  "author": "Daniel Ceron Claros <danielxceron>",
  "contributors": [
    "Kakulukian (Original author)"
  ],
  "keywords": [
    "youtube",
    "transcript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.10.0",
    "rollup": "^4.65.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/danielxceron/youtube-transcript.git",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/danielxceron/youtube-transcript",
  "engines": {
    "node": ">=18.0.0"
  }
}
